# POSTGRES ENTRYPOINT
_ENTRYPOINT_POSTGRES_CONFIG_TEMPLATE_PATH=/etc/postgres/templates/configs/postgres.conf.template
_ENTRYPOINT_POSTGRES_CONFIG_PATH=/etc/postgres/configs/postgres.conf
_ENTRYPOINT_POSTGRES_HBA_TEMPLATE_PATH=/etc/postgres/templates/configs/pg_hba.conf.template
_ENTRYPOINT_POSTGRES_HBA_PATH=/etc/postgres/configs/pg_hba.conf
_ENTRYPOINT_POSTGRES_IDENT_TEMPLATE_PATH=/etc/postgres/templates/configs/pg_ident.conf.template
_ENTRYPOINT_POSTGRES_IDENT_PATH=/etc/postgres/configs/pg_ident.conf
_ENTRYPOINT_POSTGRES_INIT_SQL_TEMPLATE_PATH=/etc/postgres/templates/init/init.sql.template
_ENTRYPOINT_POSTGRES_INIT_SQL_PATH=/etc/postgres/init/init.sql
_ENTRYPOINT_POSTGRES_PGDATA=/storage/postgres
_ENTRYPOINT_POSTGRES_HOST='parser-postgres'
_ENTRYPOINT_POSTGRES_PORT=5432
_ENTRYPOINT_POSTGRES_USER=parser-postgres
_ENTRYPOINT_POSTGRES_DB=postgres
_ENTRYPOINT_POSTGRES_SSL_KEY_PATH=/etc/ssl/postgres/server.key
_ENTRYPOINT_POSTGRES_SSL_CRT_PATH=/etc/ssl/postgres/server.crt
_ENTRYPOINT_POSTGRES_SSL_CA_CRT_PATH=/etc/ssl/ca/ca.crt

# POSTGRES CONFIG
_CONFIG_POSTGRES_HOST="'parser-postgres'"
_CONFIG_POSTGRES_PORT=5432
_CONFIG_POSTGRES_SSL_CERT_PATH="'/etc/ssl/postgres/server.crt'"
_CONFIG_POSTGRES_SSL_KEY_PATH="'/etc/ssl/postgres/server.key'"
_CONFIG_POSTGRES_SSL_CA_PATH="'/etc/ssl/ca/ca.crt'"
_CONFIG_POSTGRES_STORAGE_PATH="'/storage/postgres'"
_CONFIG_POSTGRES_HBA_CONFIG_PATH="'/etc/postgres/configs/pg_hba.conf'"
_CONFIG_POSTGRES_IDENT_CONFIG_PATH="'/etc/postgres/configs/pg_ident.conf'"

# POSTGRES HBA
_HBA_POSTGRES_NETWORK="192.168.51.0/24"

# POSTGRES IDENT
_IDENT_PARSER_POSTGRES_DN='"CN=parser-postgres,O=organizationName,L=localityName,ST=stateOrProvinceName,C=CO"'
_IDENT_PGADMIN_DN='"CN=pgadmin,O=organizationName,L=localityName,ST=stateOrProvinceName,C=CO"'
_IDENT_TWITCH_PARSER_DN='"CN=twitch-parser,O=organizationName,L=localityName,ST=stateOrProvinceName,C=CO"'
_IDENT_PARSER_POSTGRES_USER=parser-postgres
_IDENT_PGADMIN_USER=pgadmin
_IDENT_TWITCH_PARSER_USER=twitch-parser

# POSTGRES INIT SCRIPTS
_INIT_TWITCH_PARSER_DATABASE='"twitch"'
_INIT_TWITCH_PARSER_USER='"twitch-parser"'
_INIT_TWITCH_PARSER_PASSWORD="'password'"
_INIT_PGADMIN_USER='"pgadmin"'
_INIT_PGADMIN_PASSWORD="'password'"
