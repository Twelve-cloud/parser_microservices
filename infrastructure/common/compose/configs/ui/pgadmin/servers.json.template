{
    "Servers": {
        "1": {
            "Name": "${PARSER_POSTGRES_CONNECTION_NAME}",
            "Group": "Servers",
            "Host": "${PARSER_POSTGRES_HOST}",
            "Port": ${PARSER_POSTGRES_PORT},
            "MaintenanceDB": "${PARSER_POSTGRES_DB}",
            "Username": "${PARSER_POSTGRES_USER}",
            "UseSSHTunnel": 0,
            "TunnelPort": "22",
            "TunnelAuthentication": 0,
            "KerberosAuthentication": false,
            "ConnectionParameters": {
                "sslmode": "verify-full",
                "connect_timeout": 10,
                "sslcert": "/certs/server.cert",
                "sslkey": "/certs/server.key",
                "sslrootcert": "<STORAGE_DIR>/.postgresql/root.crt"
            }
        }
    }
}
