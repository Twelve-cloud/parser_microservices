# PGADMIN
PGADMIN_DEFAULT_EMAIL=email@email.com
PGADMIN_DEFAULT_PASSWORD=password
PGADMIN_ENABLE_TLS=1
PGADMIN_LISTEN_ADDRESS=0.0.0.0
PGADMIN_LISTEN_PORT=5400
PGADMIN_ALLOWED_HOSTS="['127.0.0.1', 'localhost', 'pgadmin']"
PGADMIN_SSL_CERT_PATH=/certs/server.cert
PGADMIN_SSL_KEY_PATH=/certs/server.key
PGADMIN_SSL_CA_PATH=<STORAGE_DIR>/.postgresql/root.crt
PGADMIN_STORAGE_PATH="'/storage/pgadmin'"
PGADMIN_CONF_TEMPLATE_PATH=/etc/templates/pgadmin/pgadmin.py.template
PGADMIN_CONF_PATH=/pgadmin4/config_local.py
PGADMIN_SERVERS_TEMPLATE_PATH=/etc/templates/pgadmin/servers.json.template
PGADMIN_SERVERS_PATH=/pgadmin4/servers.json
PARSER_POSTGRES_CONNECTION_NAME=TwitchParser
PARSER_POSTGRES_HOST=parser-postgres
PARSER_POSTGRES_PORT=5432
PARSER_POSTGRES_USER=username
PARSER_POSTGRES_DB=Twitch
