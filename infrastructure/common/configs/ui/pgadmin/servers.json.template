{
    "Servers": {
        "1": {
            "Name": "${_SERVERS_PARSER_POSTGRES_CONNECTION_NAME}",
            "Group": "Servers",
            "Host": "${_SERVERS_PARSER_POSTGRES_HOST}",
            "Port": ${_SERVERS_PARSER_POSTGRES_PORT},
            "Username": "${_SERVERS_PARSER_POSTGRES_USER}",
            "MaintenanceDB": "${_SERVERS_PARSER_POSTGRES_DB}",
            "UseSSHTunnel": 0,
            "TunnelPort": "22",
            "TunnelAuthentication": 0,
            "KerberosAuthentication": false,
            "ConnectionParameters": {
                "sslmode": "verify-full",
                "connect_timeout": 10,
                "sslcert": "${_SERVERS_PGADMIN_SSL_CERT_PATH}",
                "sslkey": "${_SERVERS_PGADMIN_SSL_KEY_PATH}",
                "sslrootcert": "${_SERVERS_PGADMIN_SSL_CA_PATH}"
            }
        }
    }
}
