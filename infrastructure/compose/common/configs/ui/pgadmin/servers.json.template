{
    "Servers": {
        "1": {
            "Name": "${_PARSER_POSTGRES_CONNECTION_NAME}",
            "Group": "Servers",
            "Host": "${_PARSER_POSTGRES_HOST}",
            "Port": ${_PARSER_POSTGRES_PORT},
            "MaintenanceDB": "${_PARSER_POSTGRES_DB}",
            "Username": "${_PARSER_POSTGRES_USER}",
            "UseSSHTunnel": 0,
            "TunnelPort": "22",
            "TunnelAuthentication": 0,
            "KerberosAuthentication": false,
            "ConnectionParameters": {
                "sslmode": "verify-full",
                "connect_timeout": 10,
                "sslcert": "${_PGADMIN_SSL_CERT_PATH}",
                "sslkey": "${_PGADMIN_SSL_KEY_PATH}",
                "sslrootcert": "${_PGADMIN_SSL_CA_PATH}"
            }
        }
    }
}
