# MONGO INTERNAL
MONGO_INITDB_ROOT_USERNAME=username
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=Twitch

# MONGO ENTRYPOINT
_MONGO_CONFIG_TEMPLATE_PATH=/etc/templates/mongo/mongo.conf.template
_MONGO_CONFIG_PATH=/etc/mongo/mongo.conf
_MONGO_ORIGINAL_ENTRYPOINT_PATH=/usr/local/bin/docker-entrypoint.sh

# MONGO CONFIG
_MONGO_HOST=192.168.52.1
_MONGO_PORT=27017
_MONGO_SSL_CRT_KEY_PATH=/etc/ssl/mongo/server.pem
_MONGO_SSL_CA_PATH=/etc/ssl/ca/ca.crt
_MONGO_STORAGE_PATH=/storage/mongo
