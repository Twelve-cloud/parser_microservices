# MONGO
MONGO_INITDB_ROOT_USERNAME=username
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=Twitch
MONGO_HOST='"*"'
MONGO_PORT=27017
MONGO_SSL_CERT_PATH=/etc/ssl/mongo/server.pem
MONGO_SSL_CA_PATH=/etc/ssl/ca/ca.pem
MONGO_STORAGE_PATH=/storage/mongo
MONGO_CONFIG_TEMPLATE_PATH=/etc/templates/mongo/mongo.conf.template
MONGO_CONFIG_PATH=/etc/mongo/mongo.conf
MONGO_ORIGINAL_ENTRYPOINT_PATH=/usr/local/bin/docker-entrypoint.sh
